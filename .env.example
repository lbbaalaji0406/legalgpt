# Environment Variables Template
# Copy this file to .env and fill in your values

# Groq API Configuration
# Users bring their OWN Groq key (sent in the X-Groq-Api-Key header); the server never uses a key of its own
# unless ALLOW_SERVER_GROQ_KEY=1 (private/dev deployments only). GROQ_API_KEY below is that optional fallback.
# GROQ_API_KEY=your_groq_api_key_here
# ALLOW_SERVER_GROQ_KEY=1

# Login-token signing secret (REQUIRED in production, 32+ random characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it a random secret is generated at every start and everyone is logged out on restart.
JWT_SECRET=

# ChromaDB Settings (optional - defaults work)
# CHROMA_PERSIST_DIRECTORY=./data/vector_db
# CHROMA_COLLECTION_NAME=saulgpt_indian_laws

# API Server Settings (optional)
# API_HOST=0.0.0.0
# API_PORT=8000